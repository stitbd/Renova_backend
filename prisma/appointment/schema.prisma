generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/appointment-client"
}

datasource db {
  provider = "mysql"
  url      = env("APPOINTMENT_DATABASE_URL")
}


enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum CancelledBy {
  PATIENT
  DOCTOR
  OUTLET_USER
  SUPER_ADMIN
  SYSTEM
}

model Appointment {
  id String @id @default(uuid())

  appointmentCode String @unique

  patientName String
  patientEmail String
  patientPhone String
  patientGender String
  patientDateOfBirth DateTime

  patientMedicalHistory String?


  // External IDs from Main DB
  doctorId  String
  patientId String
  outletId  String?

  appointmentDate DateTime
  startTime       DateTime
  endTime         DateTime

  type   AppointmentType   @default(IN_PERSON)
  status AppointmentStatus @default(PENDING)

  consultationFee Decimal? @db.Decimal(10, 2)

  paymentStatus PaymentStatus @default(UNPAID)

  reason       String? @db.Text
  patientNotes String? @db.Text
  doctorNotes  String? @db.Text

  cancelledBy        CancelledBy?
  cancellationReason String? @db.Text
  cancelledAt        DateTime?

  confirmedAt DateTime?
  completedAt DateTime?

  slotLock   AppointmentSlotLock?
  statusLogs AppointmentStatusLog[]
  payment    AppointmentPayment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, appointmentDate])
  @@index([patientId, appointmentDate])
  @@index([outletId, appointmentDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([startTime])
}

model AppointmentSlotLock {
  id String @id @default(uuid())

  doctorId  String
  startTime DateTime

  appointmentId String @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([doctorId, startTime])
  @@index([appointmentId])
}

model AppointmentStatusLog {
  id String @id @default(uuid())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  previousStatus AppointmentStatus?
  newStatus      AppointmentStatus

  changedById   String?
  changedByRole String?

  note String? @db.Text

  createdAt DateTime @default(now())

  @@index([appointmentId])
}


enum PaymentGateway {
  SSLCOMMERZ
  MANUAL
}

model AppointmentPayment {
  id String @id @default(uuid())

  appointmentId String @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT")

  status PaymentStatus @default(UNPAID)

  gateway PaymentGateway @default(SSLCOMMERZ)

  transactionId String @unique
  validationId  String?
  bankTransactionId String?

  paymentMethod String?
  cardType      String?

  gatewayResponse Json?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([transactionId])
  @@index([validationId])
}


//=========================videoCall ===============================

enum CallType {
  AUDIO
  VIDEO
}

enum VideoCallStatus {
  RINGING
  ACCEPTED
  REJECTED
  ENDED
  MISSED
}

model VideoCall {
  id String @id @default(uuid())

  callId      String @unique
  channelName String @unique

  appointmentId String?

  callerId   String
  receiverId String

  callerUid   Int
  receiverUid Int?

  callType CallType @default(VIDEO)

  status VideoCallStatus @default(RINGING)

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([callerId])
  @@index([receiverId])
  @@index([appointmentId])
  @@index([callType])
  @@index([status])
}

enum ChatMessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

model ChatConversation {
  id String @id @default(uuid())

  appointmentId String?

  participantOneId String
  participantTwoId String

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantOneId, participantTwoId, appointmentId])
  @@index([appointmentId])
  @@index([participantOneId])
  @@index([participantTwoId])
}

model ChatMessage {
  id String @id @default(uuid())

  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId   String
  receiverId String

  type ChatMessageType @default(TEXT)

  message  String? @db.Text
  fileUrl  String?
  fileName String?

  seenAt DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([seenAt])
}

// ==================purchase packages -====================== 



enum PackageOrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PackagePaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

enum PackagePaymentMethod {
  SSLCOMMERZ
  CASH
  MANUAL
}

model PackageOrder {
  id String @id @default(uuid())

  orderCode String @unique

  // External IDs from Main DB
  patientId String
  outletId  String?

  packageId String

  packageName     String
  subtitle        String?
  totalPrice      Decimal @db.Decimal(10, 2)
  discountedPrice Decimal @db.Decimal(10, 2)

  status        PackageOrderStatus   @default(PENDING)
  paymentStatus PackagePaymentStatus @default(UNPAID)
  paymentMethod PackagePaymentMethod?

  notes String? @db.Text

  items   PackageOrderItem[]
  payment PackagePayment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([outletId])
  @@index([packageId])
  @@index([status])
  @@index([paymentStatus])
}

model PackageOrderItem {
  id String @id @default(uuid())

  orderId String
  order   PackageOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  testId String

  testName String
  testCode String?
  price    Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([testId])
}

model PackagePayment {
  id String @id @default(uuid())

  orderId String @unique
  order   PackageOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT")

  status PackagePaymentStatus @default(UNPAID)
  method PackagePaymentMethod @default(SSLCOMMERZ)

  transactionId String @unique
  validationId  String?
  bankTransactionId String?

  paymentMethodName String?
  cardType          String?

  gatewayResponse Json?

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([transactionId])
}